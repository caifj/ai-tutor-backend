# Copy these names into your process environment. Never commit a real API key.
SPARK_API_KEY=
SPARK_API_ENDPOINT=https://maas-api.cn-huabei-1.xf-yun.com/v2/chat/completions
SPARK_MODEL=spark-x2.5-1.7b
SPARK_TIMEOUT_SECONDS=30

# Code similarity review for Python submissions.
AI_TUTOR_SIMILARITY_THRESHOLD=0.85
AI_TUTOR_SIMILARITY_MAX_PENALTY=30

# Production code execution: connect the Web container to the isolated runner UDS.
# Keep "disabled" unless the dedicated sandbox container is running.
AI_TUTOR_CODE_RUNNER=disabled
AI_TUTOR_CODE_RUNNER_SOCKET=/run/ai-tutor-sandbox/runner.sock
