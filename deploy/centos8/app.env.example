# Copy to /opt/ai-tutor/app.env and keep mode 600.
SPARK_API_KEY=replace-with-server-secret
SPARK_API_ENDPOINT=https://maas-api.cn-huabei-1.xf-yun.com/v2/chat/completions
SPARK_MODEL=spark-x2.5-1.7b
SPARK_TIMEOUT_SECONDS=30

AI_TUTOR_DB_PATH=/data/ai_tutor.db
AI_TUTOR_FRONTEND_DIR=/app/frontend/dist
AI_TUTOR_SERVE_FRONTEND=1
AI_TUTOR_CORS_ORIGINS=
AI_TUTOR_SIMILARITY_THRESHOLD=0.85
AI_TUTOR_SIMILARITY_MAX_PENALTY=30

